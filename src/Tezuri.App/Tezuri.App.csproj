<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tezuri</RootNamespace>
    <AssemblyName>Tezuri.App</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Shape of the published artifact: one file to double-click, with no runtime to install
         first, and the native webview shim folded in. `SelfContained` stays on the publish command
         rather than here, because a self-contained project cannot be referenced by the test project. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sylin.Koan.App" />
    <PackageReference Include="Sylin.Koan.Data.Core" />
    <PackageReference Include="Photino.NET" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

  <!-- The built client rides inside the executable, so the published artifact really is one file. -->
  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**" />
    <!-- Embedded is the only copy that ships; a folder beside the executable would be dead weight. -->
    <Content Remove="wwwroot/**" />
  </ItemGroup>

  <Target Name="RequireBuiltClient" BeforeTargets="PrepareForPublish"
          Condition="!Exists('$(MSBuildThisFileDirectory)wwwroot/index.html')">
    <Error Text="The client has not been built. Run 'npm run build' in ClientApp, or use eng/publish.ps1." />
  </Target>

  <!-- The client is a build input, not something to ship beside the executable; only its compiled
       output under wwwroot/ belongs in the publish folder. -->
  <ItemGroup>
    <Content Remove="ClientApp/**" />
    <None Include="ClientApp/**" Exclude="ClientApp/node_modules/**;ClientApp/dist/**" />
  </ItemGroup>
</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:article:v1",
  "title": "Example article metadata",
  "type": "object",
  "required": ["id", "title", "description", "date", "status", "standing"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "status": { "enum": ["timeless", "current", "of-its-time", "revised"] },
    "standing": { "type": "string", "maxLength": 160 },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}


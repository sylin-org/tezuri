# Absolute host path to the one repository Tezuri may read and modify.
# PowerShell example: F:\Files\repo\github\sylin-org\website
# POSIX example: /home/me/src/website
TEZURI_WORKSPACE=

# Loopback host port published by Compose.
TEZURI_PORT=8080

# Linux only: set these to `id -u` and `id -g` so created files retain host ownership.
# Docker Desktop on Windows/macOS can normally leave the defaults unchanged.
TEZURI_UID=1654
TEZURI_GID=1654


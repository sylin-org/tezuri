{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylin:tezuri:media-asset:v1",
  "title": "Tezuri media asset receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "articleId",
    "originalFileName",
    "fileName",
    "relativePath",
    "mediaType",
    "sha256",
    "byteLength",
    "deduplicated"
  ],
  "properties": {
    "protocol": { "const": "tezuri.media-asset-receipt" },
    "version": { "const": 1 },
    "articleId": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/articleId" },
    "originalFileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\u0000]+$"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\u0000]+$"
    },
    "relativePath": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
    "mediaType": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/mediaType" },
    "sha256": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Hex" },
    "byteLength": { "type": "integer", "minimum": 0 },
    "deduplicated": { "type": "boolean" }
  }
}

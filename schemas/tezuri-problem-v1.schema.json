{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylin:tezuri:problem:v1",
  "title": "Tezuri RFC 9457 problem details v1",
  "type": "object",
  "required": ["type", "title", "status", "code"],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "maxLength": 4000
    },
    "instance": {
      "type": "string",
      "format": "uri-reference"
    },
    "code": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/stableCode" },
    "operationId": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/contractId" },
    "currentHash": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Digest" },
    "retryable": { "type": "boolean" },
    "fieldErrors": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldError" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "fieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "code", "message"],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(?:|/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*)$"
        },
        "code": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/stableCode" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}

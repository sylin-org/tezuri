{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylin:tezuri:git-publication:v1",
  "title": "Tezuri Git publication protocols v1",
  "oneOf": [
    { "$ref": "#/$defs/repositorySnapshot" },
    { "$ref": "#/$defs/commitPlanRequest" },
    { "$ref": "#/$defs/commitPlan" },
    { "$ref": "#/$defs/prepareCommitRequest" },
    { "$ref": "#/$defs/commitReceipt" },
    { "$ref": "#/$defs/pushRequest" },
    { "$ref": "#/$defs/pushReceipt" }
  ],
  "$defs": {
    "objectId": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/gitCommit" },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^(?![-./])(?!.*(?:^|/)\\.)(?!.*\\.\\.)(?!.*//)(?!.*@\\{)(?!.*\\.lock$)(?!.*[./]$)[A-Za-z0-9._/-]+$"
    },
    "remote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?![-.])(?!.*\\.$)[A-Za-z0-9._-]+$"
    },
    "selectedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" }
    },
    "changedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "indexStatus", "workTreeStatus", "allowed"],
      "properties": {
        "path": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
        "indexStatus": { "$ref": "#/$defs/changeStatus" },
        "workTreeStatus": { "$ref": "#/$defs/changeStatus" },
        "allowed": { "type": "boolean" }
      }
    },
    "changeStatus": {
      "enum": [
        "none",
        "added",
        "modified",
        "deleted",
        "renamed",
        "copied",
        "type-changed",
        "unmerged",
        "untracked",
        "unknown"
      ]
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "headSha", "isUnborn", "isDetached", "branch", "upstream", "remotes", "remoteBranches", "changes"],
      "properties": {
        "protocol": { "const": "tezuri.git-repository-snapshot" },
        "version": { "const": 1 },
        "headSha": {
          "anyOf": [
            { "$ref": "#/$defs/objectId" },
            { "type": "null" }
          ]
        },
        "isUnborn": { "type": "boolean" },
        "isDetached": { "type": "boolean" },
        "branch": {
          "anyOf": [
            { "$ref": "#/$defs/branch" },
            { "type": "null" }
          ]
        },
        "upstream": { "type": ["string", "null"], "maxLength": 500 },
        "remotes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/remote" }
        },
        "remoteBranches": {
          "type": "array",
          "items": { "$ref": "#/$defs/remoteBranch" }
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/changedPath" }
        }
      }
    },
    "remoteBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "branch", "sha"],
      "properties": {
        "remote": { "$ref": "#/$defs/remote" },
        "branch": { "$ref": "#/$defs/branch" },
        "sha": { "$ref": "#/$defs/objectId" }
      }
    },
    "commitPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedPaths"],
      "properties": {
        "selectedPaths": { "$ref": "#/$defs/selectedPaths" }
      }
    },
    "commitPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "headSha", "branch", "planSha256", "selectedPaths", "changes"],
      "properties": {
        "protocol": { "const": "tezuri.git-commit-plan" },
        "version": { "const": 1 },
        "headSha": { "$ref": "#/$defs/objectId" },
        "branch": { "$ref": "#/$defs/branch" },
        "planSha256": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Hex" },
        "selectedPaths": { "$ref": "#/$defs/selectedPaths" },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/changedPath" }
        }
      }
    },
    "prepareCommitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedHeadSha", "expectedPlanSha256", "message", "selectedPaths"],
      "properties": {
        "expectedHeadSha": { "$ref": "#/$defs/objectId" },
        "expectedPlanSha256": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Hex" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "selectedPaths": { "$ref": "#/$defs/selectedPaths" }
      }
    },
    "commitReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "beforeSha", "afterSha", "branch", "planSha256", "selectedPaths", "created"],
      "properties": {
        "protocol": { "const": "tezuri.git-commit-receipt" },
        "version": { "const": 1 },
        "beforeSha": { "$ref": "#/$defs/objectId" },
        "afterSha": { "$ref": "#/$defs/objectId" },
        "branch": { "$ref": "#/$defs/branch" },
        "planSha256": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Hex" },
        "selectedPaths": { "$ref": "#/$defs/selectedPaths" },
        "created": { "type": "boolean" }
      }
    },
    "pushRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "branch", "expectedHeadSha", "expectedRemoteSha"],
      "properties": {
        "remote": { "$ref": "#/$defs/remote" },
        "branch": { "$ref": "#/$defs/branch" },
        "expectedHeadSha": { "$ref": "#/$defs/objectId" },
        "expectedRemoteSha": { "$ref": "#/$defs/objectId" }
      }
    },
    "pushReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "remote", "branch", "localSha", "remoteBeforeSha", "remoteAfterSha", "pushed"],
      "properties": {
        "protocol": { "const": "tezuri.git-push-receipt" },
        "version": { "const": 1 },
        "remote": { "$ref": "#/$defs/remote" },
        "branch": { "$ref": "#/$defs/branch" },
        "localSha": { "$ref": "#/$defs/objectId" },
        "remoteBeforeSha": { "$ref": "#/$defs/objectId" },
        "remoteAfterSha": { "$ref": "#/$defs/objectId" },
        "pushed": { "type": "boolean" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylin:tezuri:media-manifest:v1",
  "title": "Tezuri media manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "articleId", "assets"],
  "properties": {
    "schema": { "const": "tezuri.media-manifest/v1" },
    "articleId": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/articleId" },
    "generatedAt": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/utcTimestamp" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "mediaType", "bytes"],
      "properties": {
        "path": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
        "digest": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Digest" },
        "mediaType": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/mediaType" },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "source": { "$ref": "#/$defs/source" },
        "credit": {
          "type": "string",
          "maxLength": 500
        },
        "rights": { "$ref": "#/$defs/rights" },
        "derivatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/derivative" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/httpUrl" },
        "importedAt": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/utcTimestamp" }
      },
      "anyOf": [
        { "required": ["id"] },
        { "required": ["url"] }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "spdxExpression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "licenseUrl": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/httpUrl" }
      },
      "minProperties": 1
    },
    "derivative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "kind", "transformation"],
      "properties": {
        "path": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
        "digest": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Digest" },
        "kind": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/stableCode" },
        "transformation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

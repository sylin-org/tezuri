{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylin:tezuri:site-proof-run:v1",
  "title": "Tezuri site proof run receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "runId",
    "status",
    "startedAt",
    "completedAt",
    "progress",
    "result"
  ],
  "properties": {
    "protocol": { "const": "tezuri.site-proof-run" },
    "version": { "const": 1 },
    "runId": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/contractId" },
    "status": { "enum": ["passed", "failed", "timed-out", "start-failed"] },
    "startedAt": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/utcTimestamp" },
    "completedAt": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/utcTimestamp" },
    "workspaceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceDigest": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Digest" },
    "progress": { "$ref": "#/$defs/progress" },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "completedCommands", "totalCommands", "currentCommandId"],
      "properties": {
        "state": { "enum": ["passed", "failed", "timed-out", "start-failed"] },
        "completedCommands": { "type": "integer", "minimum": 0 },
        "totalCommands": { "type": "integer", "minimum": 0 },
        "currentCommandId": {
          "anyOf": [
            { "$ref": "urn:sylin:tezuri:common:v1#/$defs/stableCode" },
            { "type": "null" }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["succeeded", "commands"],
      "properties": {
        "succeeded": { "type": "boolean" },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "executable",
        "arguments",
        "status",
        "exitCode",
        "timedOut",
        "durationMilliseconds",
        "standardOutput",
        "standardError",
        "standardOutputTruncated",
        "standardErrorTruncated",
        "outputDirectory",
        "outputDirectoryExists"
      ],
      "properties": {
        "id": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/stableCode" },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "arguments": {
          "type": "array",
          "items": { "type": "string", "maxLength": 4096 }
        },
        "status": { "enum": ["passed", "failed", "timed-out", "start-failed"] },
        "exitCode": {
          "type": ["integer", "null"]
        },
        "timedOut": { "type": "boolean" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "standardOutput": { "type": "string", "maxLength": 65536 },
        "standardError": { "type": "string", "maxLength": 65536 },
        "standardOutputTruncated": { "type": "boolean" },
        "standardErrorTruncated": { "type": "boolean" },
        "outputDirectory": {
          "anyOf": [
            { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
            { "type": "null" }
          ]
        },
        "outputDirectoryExists": { "type": "boolean" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/stableCode" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "path": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
        "route": { "type": "string", "pattern": "^/" },
        "artifactId": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/contractId" },
        "evidence": { "type": "string", "maxLength": 4000 },
        "correction": { "type": "string", "maxLength": 2000 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "digest", "bytes"],
      "properties": {
        "id": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/contractId" },
        "kind": {
          "enum": [
            "rendered-site",
            "feed",
            "sitemap",
            "route-report",
            "build-log",
            "screenshot",
            "custom"
          ]
        },
        "path": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
        "digest": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/sha256Digest" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/mediaType" }
      }
    }
  }
}

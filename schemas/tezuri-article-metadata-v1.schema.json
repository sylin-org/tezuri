{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylin:tezuri:article-metadata:v1",
  "title": "Tezuri default article metadata v1",
  "description": "An optional baseline. A workspace-selected target schema remains authoritative.",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/articleId" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^/\\\\\\u0000]+$"
    },
    "date": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/editorialDate" },
    "updated": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/editorialDate" },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "canonicalUrl": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/httpUrl" },
    "publicationState": {
      "enum": ["draft", "scheduled", "published", "archived"]
    },
    "editorialCurrency": {
      "enum": ["timeless", "current", "of-its-time", "revised"]
    },
    "standing": {
      "type": "string",
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "urn:sylin:tezuri:common:v1#/$defs/repositoryPath" },
        "alt": {
          "type": "string",
          "maxLength": 1000
        },
        "decorative": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}

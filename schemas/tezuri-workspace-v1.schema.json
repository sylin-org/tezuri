{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylin:tezuri:workspace:v1",
  "title": "Tezuri workspace configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site", "articles", "media", "proof", "git"],
  "properties": {
    "schema": {
      "const": "tezuri.workspace/v1"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "articles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "fileName", "mediaDirectory", "metadataSchema"],
      "properties": {
        "root": { "$ref": "#/$defs/repositoryPath" },
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"
        },
        "mediaDirectory": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "metadataSchema": { "$ref": "#/$defs/repositoryPath" },
        "editorHints": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireOwnedAssets", "maximumAssetBytes", "allowedExtensions"],
      "properties": {
        "requireOwnedAssets": { "const": true },
        "maximumAssetBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "allowedExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingDirectory", "commands"],
      "properties": {
        "workingDirectory": {
          "anyOf": [
            { "const": "." },
            { "$ref": "#/$defs/repositoryPath" }
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/proofCommand" }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPaths"],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryGlob" }
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[*?\\[\\]]).+$"
    },
    "repositoryGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "proofCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executable", "arguments", "timeoutSeconds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "executable": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]*$",
          "not": {
            "enum": [
              "bash",
              "cmd",
              "cmd.exe",
              "powershell",
              "powershell.exe",
              "pwsh",
              "pwsh.exe",
              "sh",
              "zsh"
            ]
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000\\r\\n]*$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "outputDirectory": { "$ref": "#/$defs/repositoryPath" }
      }
    }
  }
}
